# Browser-visible settings. Get the URL and publishable key from the Supabase
# project Connect dialog or Settings -> API Keys. Publishable keys are safe to
# ship to the browser because RLS still controls access.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<copy-from-supabase>

# Legacy compatibility only. Leave this unset when using the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only ingestion settings. Get the secret key from Supabase Settings ->
# API Keys. Never use it as a NEXT_PUBLIC_* variable or commit its value.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<copy-from-supabase>

# Legacy compatibility only. Leave this unset when using the secret key.
# SUPABASE_SERVICE_ROLE_KEY=

# One random 32+ character HMAC secret per commissioned device. Keep this only
# in web/.env.local/Vercel server environment; never commit the real values.
INGEST_DEVICE_SECRETS_JSON={}
